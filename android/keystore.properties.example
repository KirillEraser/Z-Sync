# Copy to keystore.properties (gitignored) to build signed release APKs locally.
# Paths are relative to android/. Never commit this file or the .jks it points at,
# and keep a backup of the keystore outside this repo: losing it means the Play
# upload key has to be reset.
storeFile=zencompanion-release.jks
storePassword=CHANGEME
keyAlias=zencompanion
keyPassword=CHANGEME
