{
  "contract": 1,
  "id": "wire-folder-live-object",
  "purpose": "A folder's live object decodes to provider metadata; unmodelled state members (maxItems, timeRange) are ignored and icon null stays null.",
  "input": {
    "id": "f1",
    "kind": "folder",
    "data": {
      "folderId": "f1",
      "name": "Docs",
      "icon": null,
      "workspaceUuid": "space-a",
      "parentFolderId": null,
      "live": {
        "type": "rss",
        "state": {
          "url": "https://example.com/feed.xml",
          "maxItems": 10,
          "timeRange": 0
        }
      },
      "children": ["t2"]
    }
  },
  "expect": {
    "decodesAs": "folder",
    "folderId": "f1",
    "name": "Docs",
    "icon": null,
    "workspaceUuid": "space-a",
    "parentFolderId": null,
    "children": ["t2"],
    "isLiveFolder": true,
    "liveType": "rss",
    "liveSourceURL": "https://example.com/feed.xml"
  }
}
